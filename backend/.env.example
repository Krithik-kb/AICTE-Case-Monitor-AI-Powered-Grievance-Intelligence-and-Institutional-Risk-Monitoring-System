# Backend Environment Configuration Example
# Copy to backend/.env

# Database (Default: local SQLite fallback. For production, supply Supabase PostgreSQL URL)
DATABASE_URL=sqlite:///./aicte_monitor.db
# Example Supabase: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT Secret & Encryption
SECRET_KEY=aicte_sih_secure_secret_key_2026_jwt_token_auth_salt_9981
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=127.0.0.1
PORT=8000
